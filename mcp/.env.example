# Cargos API the MCP server calls. In Docker Compose this is http://api:3000
CARGOS_API_URL=http://localhost:3010

# Preferred: a write API key from Settings → API keys (ck_live_…). Never expires until revoked.
CARGOS_API_KEY=

# Optional fallback: email/password used once at startup to mint and store an API key.
CARGOS_EMAIL=
CARGOS_PASSWORD=

# Where the minted key is stored (mode 0600). Default is ./data/auth.json
MCP_AUTH_PATH=

# stdio (Cursor local) or http (https://cargos.pro/mcp)
MCP_TRANSPORT=http
MCP_PORT=3100
MCP_BIND=127.0.0.1

# Origin Claude uses for OAuth. Must match the connector URL, with no path.
PUBLIC_URL=https://cargos.pro

# Optional. Defaults to oauth.json beside MCP_AUTH_PATH.
MCP_OAUTH_PATH=

# Required in production. Cursor sends Authorization: Bearer <secret>. Claude signs in with OAuth instead.
MCP_SHARED_SECRET=
