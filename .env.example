# Copy to .env before production deploy:
#   cp .env.example .env

DOMAIN=cargos.pro
ACME_EMAIL=ops@cargos.pro

POSTGRES_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string

# Public URL of the web app (OAuth redirects and Stripe return URLs)
PUBLIC_URL=https://cargos.pro

# Optional. Distance falls back to a road estimate when unset.
GOOGLE_MAPS_API_KEY=

# Optional. Subscription checkout stays disabled until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional platform SMS. Workflows log the message when unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional. Google connect stays unavailable until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. QuickBooks connect stays unavailable until both are set.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# DigitalOcean Spaces (required for document uploads)
SPACES_ENDPOINT=
SPACES_REGION=fra1
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

# MCP at https://cargos.pro/mcp (native Node + Nginx in production)
CARGOS_API_KEY=
MCP_SHARED_SECRET=
